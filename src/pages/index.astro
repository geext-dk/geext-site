---
import Layout from "../layouts/Layout.astro";
import { photos } from "../lib/photos";
import { projects } from "../lib/projects";
import { siteConfig } from "../site.config";
import ProfileHeader from "../components/ProfileHeader.astro";

const recentPhotos = photos.slice(0, 5);
const featuredProjects = projects.slice(0, 3);
const { name, profile } = siteConfig;
const profileBackgroundPhoto = photos.find(
  (photo) => photo.id === profile.backgroundPhotoId,
);

if (!profileBackgroundPhoto) {
  throw new Error(
    `Profile background photo not found: ${profile.backgroundPhotoId}`,
  );
}

const getProjectActionLabel = (linkType: "appstore" | "simple" | undefined) =>
  linkType === "appstore" ? "Download on the App Store" : "Learn more";
---

<Layout title={name}>
  <main class="dashboard">
    <ProfileHeader backgroundUrl={profileBackgroundPhoto.images.large.url} />

    <section
      class="dashboard-section photography-overview"
      aria-labelledby="photography-title"
    >
      <div class="section-heading">
        <div>
          <h2 id="photography-title">Photography</h2>
          <p>Most recent photos from the archive.</p>
        </div>
        <a href="/photography/">View all</a>
      </div>

      <div class="recent-photos">
        {
          recentPhotos.map((photo, index) => (
            <a
              class="recent-photo"
              href="/photography/"
              aria-label={`Open photography archive from recent photo ${index + 1}`}
            >
              <img
                src={photo.images.grid.url}
                srcset={`${photo.images.thumb.url} 480w, ${photo.images.grid.url} 960w`}
                sizes="(max-width: 700px) 33vw, (max-width: 900px) 25vw, 14rem"
                width={photo.images.grid.width ?? undefined}
                height={photo.images.grid.height ?? undefined}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          ))
        }
      </div>
    </section>

    <section
      id="projects"
      class="dashboard-section projects-section"
      aria-labelledby="projects-title"
    >
      <div class="section-heading">
        <div>
          <h2 id="projects-title">Projects</h2>
          <p>Selected work and experiments.</p>
        </div>
        <a href="/projects/">View all</a>
      </div>

      <div class="project-list">
        {
          featuredProjects.map((project) => {
            return (
              <article class="project-entry">
                {project.url ? (
                  <a class="project-title-link" href={project.url}>
                    {project.title}
                  </a>
                ) : (
                  <span>{project.title}</span>
                )}
                <p>{project.description}</p>
                {project.url ? (
                  <a
                    class:list={[
                      "project-action",
                      {
                        "project-action-appstore":
                          project.linkType === "appstore",
                      },
                    ]}
                    href={project.url}
                    aria-label={`${getProjectActionLabel(project.linkType)}: ${project.title}`}
                  >
                    {project.linkType === "appstore" ? (
                      <img
                        src="/download-on-appstore-icon.svg"
                        alt=""
                        width="120"
                        height="40"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      getProjectActionLabel(project.linkType)
                    )}
                  </a>
                ) : null}
                {project.sourceUrl ? (
                  <a
                    class="project-source"
                    href={project.sourceUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Source code
                  </a>
                ) : null}
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
  }

  .dashboard-section {
    padding: 4rem 0 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
  }

  .section-heading div {
    display: grid;
    gap: 0.35rem;
  }

  h2 {
    color: #111;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .section-heading p {
    color: #555;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .section-heading a {
    flex: 0 0 auto;
    color: #111;
    font-size: 0.95rem;
    text-underline-offset: 0.18em;
  }

  .recent-photos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .recent-photo {
    display: block;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #ece8df;
  }

  .recent-photo img {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .recent-photo:hover img {
    transform: scale(1.03);
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-entry {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    min-width: 0;
    padding: 0 1.25rem 1.35rem 0;
    margin-bottom: 1.25rem;
    color: #111;
    text-decoration: none;
    text-align: center;
  }

  .project-entry + .project-entry {
    padding-left: 1.25rem;
    border-left: 1px solid #ddd8ce;
  }

  .project-entry span,
  .project-title-link {
    color: #111;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .project-entry p {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .project-action,
  .project-source {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    margin-top: 0.15rem;
    padding: 0 0.8rem;
    border: 1px solid #111;
    border-radius: 999px;
    color: #111;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .project-action-appstore {
    min-height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .project-action-appstore img {
    display: block;
    width: 7.5rem;
    height: 2.5rem;
  }

  .project-title-link:hover,
  .project-title-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .project-action:hover,
  .project-action:focus-visible,
  .project-source:hover,
  .project-source:focus-visible {
    background: #111;
    color: #fff;
  }

  .project-action-appstore:hover,
  .project-action-appstore:focus-visible {
    background: transparent;
    color: inherit;
  }

  @media (max-width: 900px) {
    .recent-photos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .recent-photo:nth-child(n + 5) {
      display: none;
    }

    .project-list {
      grid-template-columns: 1fr;
    }

    .project-entry,
    .project-entry + .project-entry {
      padding-right: 0;
      padding-left: 0;
      border-bottom: 1px solid #ddd8ce;
      border-left: 0;
    }
  }

  @media (max-width: 700px) {
    .dashboard-section {
      display: flex;
      flex-direction: column;
      padding-top: 3rem;
    }

    .section-heading {
      display: contents;
    }

    .section-heading div {
      margin-bottom: 1.25rem;
    }

    .section-heading a {
      align-self: start;
      margin-top: 1rem;
      order: 1;
    }

    .recent-photos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .recent-photo:nth-child(n + 4) {
      display: none;
    }
  }
</style>
