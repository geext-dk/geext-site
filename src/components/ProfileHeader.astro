---
import {
  faGithub,
  faInstagram,
  faLinkedin,
} from "@fortawesome/free-brands-svg-icons";

import { siteConfig } from "../site.config";

interface Props {
  backgroundUrl: string;
  isCompact?: boolean;
}

const { backgroundUrl, isCompact } = Astro.props;

const { name, profile } = siteConfig;
const profileBackgroundStyle = `--profile-background-image: url("${backgroundUrl}");`;
const socialIcons = {
  github: faGithub,
  instagram: faInstagram,
  linkedin: faLinkedin,
};

const socialLinks = profile.socialLinks.map((link) => {
  const icon = socialIcons[link.icon];
  const [width, height, , , pathData] = icon.icon;

  return {
    ...link,
    height,
    pathData: Array.isArray(pathData) ? pathData : [pathData],
    width,
  };
});
---

<section
  class:list={["profile-section", { compact: isCompact }]}
  style={profileBackgroundStyle}
  aria-labelledby="profile-title"
>
  <div class="profile-content">
    <div class="avatar">
      {
        profile.avatarUrl ? (
          <img
            src={profile.avatarUrl}
            alt=""
            width="512"
            height="512"
            loading="eager"
            decoding="async"
          />
        ) : null
      }
    </div>
    <div class="profile-description">
      <h1 id="profile-title">{name}</h1>
      <p>{profile.about}</p>
      <nav class="profile-links" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              aria-label={link.label}
              title={link.label}
            >
              <svg
                aria-hidden="true"
                viewBox={`0 0 ${link.width} ${link.height}`}
                width="20"
                height="20"
              >
                {link.pathData.map((path) => (
                  <path d={path} />
                ))}
              </svg>
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>

<style>
  h1,
  p {
    margin: 0;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
  }

  .profile-section {
    display: grid;
    place-items: center;
    min-height: min(32rem, calc(100vh - 10rem));
    padding: 4rem 1.5rem;
    border: 1px solid #ddd8ce;
    background-color: #343633;
    background:
      linear-gradient(rgba(17, 17, 17, 0.18), rgba(17, 17, 17, 0.5)),
      var(--profile-background-image);
    background-position: center;
    background-size: cover;
    color: #ffffff;
    text-align: center;
  }

  .profile-section.compact {
    min-height: auto;
    padding: 2rem 1.5rem;
    text-align: start;
    place-items: start;
  }

  .compact h1 {
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .compact .profile-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2rem;
  }

  .profile-content {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  .profile-content p {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .profile-description {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .profile-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 0.15rem;
  }

  .compact .profile-links {
    justify-content: start;
  }

  .profile-links a {
    display: grid;
    place-items: center;
    width: 2.35rem;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .profile-links svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .profile-links a:hover,
  .profile-links a:focus-visible {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.52);
    color: #fff;
    transform: translateY(-1px);
  }

  .avatar {
    width: clamp(7rem, 16vw, 10rem);
    aspect-ratio: 1;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    background:
      linear-gradient(rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.08)),
      rgba(255, 255, 255, 0.18);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.18);
    overflow: hidden;
  }

  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .profile-section {
      margin-inline: calc(50% - 50vw);
      border-inline: 0;
    }
  }

  @media (max-width: 700px) {
    .profile-section {
      min-height: 28rem;
      padding: 3rem 1rem;
    }

    .profile-section.compact {
      min-height: auto;
      padding: 1.5rem 1rem;
    }
  }
</style>
