---
interface Props {
  title: String;
  subtitle: String;
}

const { title, subtitle } = Astro.props;
---

<header class="page-header">
  <h1>{title}</h1>
  <p>{subtitle}</p>
</header>

<style>
  .page-header {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 2rem;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    color: #111;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
  }
</style>
