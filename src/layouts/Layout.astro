---
interface Props {
  title?: string;
}

const { title = "Denis Karpovskii" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico?v=20260526" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Finlandica+Text:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-name" href="/">Denis Karpovskii</a>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >
          <span class="menu-toggle-label">Menu</span>
          <span class="menu-toggle-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/">Home</a>
          <a href="/photography/">Photography</a>
          <a href="/projects/">Projects</a>
          <a href="/tech/">Tech</a>
          <a href="/life/">Life</a>
        </nav>
      </header>

      <nav
        id="mobile-navigation"
        class="mobile-nav"
        aria-label="Mobile navigation"
        hidden
      >
        <a href="/">Home</a>
        <a href="/photography/">Photography</a>
        <a href="/projects/">Projects</a>
        <a href="/tech/">Tech</a>
        <a href="/life/">Life</a>
      </nav>

      <div class="page-content">
        <slot />
      </div>

      <footer class="site-footer">
        <p>&copy; Denis Karpovskii</p>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    background: #fbfaf6;
    color: #111;
    font-family:
      "Finlandica Text",
      Aptos,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 2px solid #111;
    outline-offset: 4px;
  }

  .site-shell {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
  }

  .site-header,
  .site-footer {
    width: min(100% - 2rem, 76rem);
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 1rem 0;
  }

  .site-name {
    color: #111;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.85rem 1.25rem;
  }

  .site-nav a {
    color: #111;
    font-size: 0.95rem;
    line-height: 1.4;
    text-decoration: none;
    text-decoration-line: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    text-decoration: underline;
    text-decoration-line: underline;
  }

  .menu-toggle,
  .mobile-nav {
    display: none;
  }

  .site-footer {
    padding: 2rem 0 2.5rem;
    color: #76716a;
  }

  .site-footer p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .page-content {
    width: min(100% - 2rem, 76rem);
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  @media (max-width: 700px) {
    .site-header,
    .site-footer {
      width: min(100% - 1.25rem, 76rem);
    }

    .site-header {
      min-height: 3rem;
      padding: 0;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      border: 0;
      padding: 0.45rem 0;
      background: transparent;
      color: #111;
      font: inherit;
      font-size: 0.95rem;
      cursor: pointer;
    }

    .menu-toggle-icon {
      display: grid;
      gap: 4px;
      width: 1.1rem;
    }

    .menu-toggle-icon span {
      display: block;
      width: 100%;
      height: 1px;
      background: currentColor;
      transition:
        transform 180ms ease,
        opacity 180ms ease;
    }

    .menu-toggle[aria-expanded="true"] .menu-toggle-icon span:first-child {
      transform: translateY(5px) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] .menu-toggle-icon span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle[aria-expanded="true"] .menu-toggle-icon span:last-child {
      transform: translateY(-5px) rotate(-45deg);
    }

    .site-nav {
      display: none;
    }

    .mobile-nav {
      width: min(100% - 1.25rem, 76rem);
      margin: 0 auto;
    }

    .mobile-nav[hidden] {
      display: none;
    }

    .mobile-nav:not([hidden]) {
      display: grid;
    }

    .mobile-nav a {
      padding: 0.75rem 0;
      border-top: 1px solid #dfddd7;
      color: #111;
      font-size: 1rem;
      text-decoration: none;
    }

    .page-content {
      padding-bottom: 3rem;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileNavigation =
    document.querySelector<HTMLElement>("#mobile-navigation");

  if (menuToggle && mobileNavigation) {
    const closeMenu = () => {
      menuToggle.setAttribute("aria-expanded", "false");
      mobileNavigation.hidden = true;
    };

    menuToggle.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      mobileNavigation.hidden = isOpen;
    });

    mobileNavigation.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  }
</script>
